<Project>
  <PropertyGroup>
    <!-- Re-enabled: VS2026 MSBuild 18.x fixed the CS2012 WPF temp assembly lock (VBCSCompiler) -->
    <UseSharedCompilation>true</UseSharedCompilation>

    <!-- Suppress CA1416 (platform compatibility) — app is 100% Windows-only, net10.0-windows TFM -->
    <!-- Suppress CS8622 (nullable event handler parameter mismatch) — .NET 10 WinForms delegates use nullable sender -->
    <!-- Suppress CS8618 (non-nullable field uninitialized) — WinForms designer fields set in InitializeComponent() -->
    <NoWarn>$(NoWarn);CA1416;CS8622;CS8618</NoWarn>

    <!-- Treat select compiler warnings as errors (safe subset — unused vars, unreachable code) -->
    <WarningsAsErrors>CS0168;CS0219;CS0162;CS0164</WarningsAsErrors>

    <!-- Code quality analyzers -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>

  <!-- Reproducible output: the same commit must produce the same bytes, whichever folder
       (worktree, temp build tree, CI runner) it is built in. MINI update packages are a
       hash diff against a published FULL, so any churn here ships files that did not change.
       - Deterministic: compiler output depends only on its inputs (SDK default; stated here
         because ObjectListView used to turn it off).
       - ContinuousIntegrationBuild + PathMap: the checkout path does not enter the PDB path
         in the DLL's debug directory or the source paths inside the PDB. Source Link maps the
         repository root to /_/; the explicit PathMap is the same mapping for builds where
         Source Link finds no git repository. Debug builds keep real paths for debugging; test
         projects (not shipped) keep them too, because tests find repository files through
         [CallerFilePath].
       - GenerateSatelliteAssembliesForCore: VS (.NET Framework) MSBuild otherwise builds the
         satellite resource assemblies with AL.exe, which stamps a time and a random MVID. -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <GenerateSatelliteAssembliesForCore>true</GenerateSatelliteAssembliesForCore>
  </PropertyGroup>
  <PropertyGroup Condition="!$(Configuration.StartsWith('Debug')) and !$(MSBuildProjectName.EndsWith('Tests')) and !$(MSBuildProjectName.EndsWith('Specs'))">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <PathMap>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)'))=/_/</PathMap>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Roslynator.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Meziantou.Analyzer">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
